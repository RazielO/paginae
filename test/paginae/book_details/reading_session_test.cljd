(ns paginae.book-details.reading-session-test
  {:no-dynamic true}
  (:require [cljd.test :refer [deftest is testing]]
            [paginae.book-details.timer.reading-session :as session]
            [paginae.types.session :as session-type]))

(deftest parse-live-test
  (testing "parses a well-formed session string"
    (let [s (session-type/from-json "{\"started-at\": 1700000000, \"accumulated\": 300, \"running\": true, \"updated-at\": 1700000100, \"book-id\": \"book-1\"}")]
      (is (= 1700000000 (:started-at s)))
      (is (= 300 (:accumulated s)))
      (is (true? (:running s)))
      (is (= 1700000100 (:updated-at s)))
      (is (= "book-1" (:book-id s)))))

  (testing "parses a paused (not running) session"
    (let [s (session-type/from-json "{\"started-at\": 1700000000, \"accumulated\": 300, \"running\": false, \"updated-at\": 1700000100, \"book-id\": \"book-1\"}")]
      (is (false? (:running s))))))

(defn- stale-window
  "The configured staleness window in seconds (3 hours)."
  []
  (* 3 3600))

(deftest stale-running?-test
  (testing "a running session touched recently is not stale"
    (let [now (session/now-in-seconds)
          s {:running true :updated-at (dec now)}]
      (is (false? (session/stale-running? s)))))

  (testing "a running session just under the window is not stale"
    (let [now (session/now-in-seconds)
          s {:running true :updated-at (- now (dec (stale-window)))}]
      (is (false? (session/stale-running? s)))))

  (testing "a running session beyond the window is stale"
    (let [now (session/now-in-seconds)
          s {:running true :updated-at (- now (inc (stale-window)))}]
      (is (true? (session/stale-running? s)))))

  (testing "a paused session is never stale"
    (let [now (session/now-in-seconds)
          s {:running false :updated-at (- now 36000)}]
      (is (false? (session/stale-running? s)))))

  (testing "a nil session is not stale"
    (is (false? (session/stale-running? nil)))))
