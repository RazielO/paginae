(ns paginae.types.activity-test
  {:no-dynamic true}
  (:require [cljd.test :refer [deftest is testing]]
            [paginae.types.activity :as activity]))

(deftest from-db-entry-test
  (testing "maps a plain db row (id key)"
    (let [a (activity/from-db-entry {"id" 5
                                     "book_id" "book-1"
                                     "reading_time" 3600
                                     "progress" 0.25
                                     "date" "2024-01-02T10:20:30.000"
                                     "created_at" "2024-01-02T10:20:30.000"})]
      (is (= 5 (:id a)))
      (is (= "book-1" (:book-id a)))
      (is (= 3600 (:reading-time a)))
      (is (= 0.25 (:progress a)))
      (is (some? (:date a)))
      (is (some? (:created-at a))))))

(deftest from-db-join-entry-test
  (testing "maps a joined row (activity_id key)"
    (let [a (activity/from-db-entry {"activity_id" 5
                                          "book_id" "book-1"
                                          "reading_time" 3600
                                          "progress" 0.25
                                          "date" "2024-01-02T10:20:30.000"
                                          "created_at" "2024-01-02T10:20:30.000"})]
      (is (= 5 (:id a)))
      (is (= "book-1" (:book-id a)))
      (is (= 3600 (:reading-time a)))
      (is (= 0.25 (:progress a))))))

(deftest activity->db-map-test
  ;; NOTE: to-db-map always writes the current time as the date, ignoring
  ;; (:date activity). That is intended for the insert-only usage but is worth
  ;; documenting here (see todo R11).
  (testing "serializes fields and drops the id (DB autoincrements)"
    (let [m (activity/activity->db-map
             (activity/map->Activity
              {:id 5 :book-id "book-1" :reading-time 3600 :progress 0.25}))]
      (is (= "book-1" (get m "book_id")))
      (is (= 3600 (get m "reading_time")))
      (is (= 0.25 (get m "progress")))
      (is (nil? (get m "id")) "id is dropped (DB autoincrements)")
      (is (some? (get m "date")) "date is always present (currently now)")
      (is (some? (get m "created_at")) "created_at is always present (currently now)"))))

(deftest date-round-trip-test
  (testing "writes UTC and reads back local, preserving the instant"
    (let [a (activity/map->Activity
             {:book-id "book-1"
              :date (dart:core/DateTime. 2024 1 2 23 30)})
          stored (activity/activity->db-map a)
          back (activity/from-db-entry {"book_id" "book-1"
                                        "date" (get stored "date")
                                        "created_at" (get stored "created_at")})]
      (is (.endsWith ^dart:core/String (get stored "date") "Z") "stored date is UTC ISO-8601")
      (is (false? (.-isUtc (:date back))) "read back as local")
      (is (= (.millisecondsSinceEpoch (:date a))
             (.millisecondsSinceEpoch (:date back))) "instant survives the round trip")))

  (testing "reads a UTC row as local without shifting the instant"
    (let [row {"book_id" "book-1"
               "date" "2024-01-02T21:30:00.000Z"
               "created_at" "2024-01-02T21:30:00.000Z"}
          a (activity/from-db-entry row)]
      (is (false? (.-isUtc (:date a))))
      (is (= 1704231000000 (.millisecondsSinceEpoch (:date a)))))))
