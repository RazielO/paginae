(ns paginae.types.note-test
  {:no-dynamic true}
  (:require [cljd.test :refer [deftest is testing]]
            [paginae.types.note :as note]))

(deftest from-db-entry-test
  (testing "maps db row to a Note"
    (let [n (note/from-db-entry {"id" 1
                                 "book_id" "book-1"
                                 "contents" "Great"
                                 "created_at" "2024-01-02 10:20:30"
                                 "updated_at" "2024-01-02 10:20:30"})]
      (is (= 1 (:id n)))
      (is (= "book-1" (:book-id n)))
      (is (= "Great" (:contents n)))
      (is (some? (:created-at n)) "parses created_at")
      (is (some? (:updated-at n)) "parses updated_at"))))

(deftest to-db-roundtrip-test
  (testing "to-db-map omits created_at (DB supplies the default)"
    (let [m (note/to-db-map (note/map->Note
                             {:id 1 :book-id "book-1" :contents "Great"}))]
      (is (= 1 (get m "id")))
      (is (= "book-1" (get m "book_id")))
      (is (= "Great" (get m "contents")))
      (is (not (nil? (get m "created_at"))) "created_at is set at current time")
      (is (not (nil? (get m "updated_at"))) "updated_at is set at current time"))))

(deftest update-contents-test
  (testing "immutably updates contents"
    (let [n (note/map->Note {:id 1 :book-id "book-1" :contents "Old"})
          u (note/update-contents n "New")]
      (is (= "New" (:contents u)))
      (is (= "Old" (:contents n)) "original unchanged"))))
