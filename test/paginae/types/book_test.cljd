(ns paginae.types.book-test
  {:no-dynamic true}
  (:require [cljd.test :refer [deftest is testing]]
            [paginae.types.book :as book]))

(defn- db-entry
  "A representative row as returned by the SQLite layer."
  []
  {"id" "book-1"
   "title" "Dune"
   "author" "Frank Herbert"
   "pages" 412
   "status" "reading"
   "format" "paperback"
   "favorite" 1
   "has_cover" 1
   "current_progress" 0.5
   "created_at" "2024-01-02 10:20:30"
   "updated_at" "2024-01-02 10:20:30"})

(deftest empty-book-test
  (testing "creates sensible defaults"
    (let [b (book/empty-book)]
      (is (some? (:id b)) "generates an id")
      (is (nil? (:title b)))
      (is (nil? (:author b)))
      (is (= :to-read (:status b)))
      (is (= :hardcover (:format b)))
      (is (= 0.0 (:current-progress b)))
      (is (false? (:favorite b)))
      (is (false? (:has-cover? b)))
      (is (nil? (:local-cover? b))))))

(deftest to-db-roundtrip-test
  (testing "to-db-map serializes fields"
    (let [b (assoc (book/empty-book)
                   :title "Dune"
                   :pages 412
                   :status :reading
                   :format :ebook
                   :current-progress 0.75
                   :favorite true
                   :has-cover? true)
          m (book/to-db-map b)]
      (is (= "reading" (get m "status")))
      (is (= "ebook" (get m "format")))
      (is (= 1 (get m "favorite")))
      (is (= 1 (get m "has_cover")))
      (is (= 412 (get m "pages")))))

  (testing "from-db-entry reads int flags back to booleans"
    (let [b (book/from-db-entry (db-entry))]
      (is (= "book-1" (:id b)))
      (is (= "Dune" (:title b)))
      (is (= "Frank Herbert" (:author b)))
      (is (= 412 (:pages b)))
      (is (= :reading (:status b)))
      (is (= :paperback (:format b)))
      (is (= 0.5 (:current-progress b)))
      (is (true? (:favorite b)))
      (is (true? (:has-cover? b)))))

  (testing "zero flags read as false"
    (let [b (book/from-db-entry (assoc (db-entry)
                                       "favorite" 0
                                       "has_cover" 0))]
      (is (false? (:favorite b)))
      (is (false? (:has-cover? b)))))

  (testing "from-db-entry keeps local-cover? true"
    (is (true? (:local-cover? (book/from-db-entry (db-entry)))))))

(deftest done-progress?-test
  (testing "completes near 1.0"
    (is (true? (book/done-progress? 1.0)))
    (is (true? (book/done-progress? 0.9995)))
    (is (true? (book/done-progress? 1.0005))))
  (testing "does not complete when far from 1.0"
    (is (false? (book/done-progress? 0.99)))
    (is (false? (book/done-progress? 0.5)))
    (is (false? (book/done-progress? 0.0)))))

(deftest update-current-progress-test
  (testing "marks done near 1.0"
    (let [b (book/update-current-progress (book/empty-book) 1.0)]
      (is (= :done (:status b)))
      (is (= 1.0 (:current-progress b)))))
  (testing "marks reading otherwise"
    (let [b (book/update-current-progress (book/empty-book) 0.5)]
      (is (= :reading (:status b)))
      (is (= 0.5 (:current-progress b))))))

(deftest update-helpers-test
  (testing "update-* return new books without mutating"
    (let [base (book/empty-book)
          t (book/update-title base "Dune")
          a (book/update-author t ["Frank" "Herbert"])
          p (book/update-pages a 412)
          s (book/update-status p :done)
          f (book/update-format s :hardcover)
          fav (book/update-favorite-status f true)]
      (is (= "Dune" (:title t)))
      (is (= ["Frank" "Herbert"] (:author a)) "update-author keeps collections as-is")
      (is (= 412 (:pages p)))
      (is (= :done (:status s)))
      (is (= :hardcover (:format f)))
      (is (true? (:favorite fav)))
      (is (nil? (:title base)) "original is unchanged")))

  (testing "update-cover"
    (let [b (book/update-cover (book/empty-book) "http://x.jpg" false)]
      (is (= "http://x.jpg" (:cover-uri b)))
      (is (false? (:local-cover? b)))
      (is (true? (:has-cover? b)))))

  (testing "update-local-cover"
    (let [b (book/update-local-cover (book/empty-book) "local.jpg")]
      (is (= "local.jpg" (:cover-uri b)))
      (is (true? (:local-cover? b)))
      (is (true? (:has-cover? b))))))
