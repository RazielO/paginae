(ns paginae.book-search.query-test
  {:no-dynamic true}
  (:require [cljd.test :refer [deftest is testing]]
            [paginae.book-search.query :as query]))

(defn- doc
  "Testing query object"
  [m]
  (merge {"title" "Dune" "key" "/works/OL123"} m))

(deftest keep-book?-test
  (testing "keeps a doc with key and non-blank title"
    (is (true? (query/keep-book? (doc {})))))

  (testing "rejects a doc without a title"
    (is (false? (query/keep-book? (doc {"title" nil}))))
    (is (false? (query/keep-book? (dissoc (doc {}) "title")))))

  (testing "rejects a blank/whitespace title"
    (is (false? (query/keep-book? (doc {"title" ""}))))
    (is (false? (query/keep-book? (doc {"title" "   "})))))

  (testing "rejects a doc without a key"
    (is (false? (query/keep-book? (dissoc (doc {}) "key"))))))
