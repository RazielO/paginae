(ns paginae.database
  {:no-dynamic true}
  (:require ["dart:async" :as dart:async]
            ["package:flutter/services.dart" :as services]
            ["package:path/path.dart" :as path]
            ["package:sqflite/sqflite.dart" :as sqlite]
            [clojure.string :as str]
            [paginae.types.activity :as activity-type]
            [paginae.types.book :as book-type]
            [paginae.types.note :as note-type]))

;; ************************************************
;; * Database setup                               *
;; ************************************************
(def books-table "books")
(def notes-table "notes")
(def activities-table "activities")
(def schema-path "assets/sql/schema.sql")
(def database-file "paginae.db")

(defn run-schema
  "Execute a SQL schema in the database"
  [^sqlite/Database db sql]
  (doseq [stmt (remove str/blank?
                       (str/split sql #";"))]
    (.execute db stmt)))

(defn ^dart:async/Future load-schema
  "Load the SQL schema"
  []
  (.loadString services/rootBundle schema-path))

(defn ^#/(dart:async/Future sqlite/Database) init-db
  "Initialize the database"
  []
  (let [path (await (sqlite/getDatabasesPath))
        db-path (path/join path database-file)]

    (await
     ^#/(dart:async/Future sqlite/Database)
     (sqlite/openDatabase
      db-path

      .version 1

      .onConfigure
      (fn [^sqlite/Database db]
        (.execute db "PRAGMA foreign_keys = ON"))

      .onCreate
      (fn [^sqlite/Database db _version]
        (let [schema (await (load-schema))]
          (await (run-schema db schema))))))))

(defonce db-instance
  (atom nil))

(defn ^#/(dart:async/Future sqlite/Database) get-db
  "Return the database instance, if not initialized, initialize it first.
   Failures are never cached: the next call will retry initialization."
  []
  (or @db-instance
      (let [db (await (init-db))]
        (reset! db-instance db)
        db)))

;; ************************************************
;; * Books queries                                *
;; ************************************************
(defn get-all-books
  "Query all books"
  []
  (let [db (await (get-db))]
    (->>
     (await
      (.query db
              books-table
              .orderBy "created_at DESC"))
     (map book-type/from-db-entry))))

(defn get-book-counts
  "Query the book counts by status"
  []
  (let [db (await (get-db))]
    (->>
     (await
      (.rawQuery db
                 "SELECT status, COUNT(*) as count
                              FROM books
                              GROUP BY status
                          UNION
                          SELECT 'favorite' AS status,
                                 COUNT(*) as count
                              FROM books
                              WHERE favorite = 1"))
     (map #(into {} %))
     (map (fn [row]
            [(keyword (get row "status")) (get row "count")]))
     (into {})
     (merge
      {:to-read 0
       :reading 0
       :done 0
       :favorite 0}))))

(defn get-books-by-status
  "Query books that have a certain status"
  [status]
  (let [db (await (get-db))]
    (->>
     (await
      (.query db
              books-table
              .where "status = ?"
              .whereArgs [(name status)]
              .orderBy "created_at DESC"))
     (map book-type/from-db-entry))))

(defn get-favorite-books
  "Query favorite books"
  []
  (let [db (await (get-db))]
    (->>
     (await
      (.query db
              books-table
              .where "favorite = 1"
              .orderBy "created_at DESC"))
     (map book-type/from-db-entry))))

(defn insert-book
  "Insert a book into the database"
  [^book-type/Book book]
  (let [db (await (get-db))]
    (await
     (.insert db
              "books"
              (book-type/to-db-map book)))))

(defn insert-book-note
  "Insert a note into the database for a given book"
  [note-contents
   book-id]
  (let [db (await (get-db))]
    (await
     (.insert db
              notes-table
              {"contents" note-contents
               "book_id" book-id}))))

(defn update-book
  "Update a book in the database"
  [^book-type/Book book]
  (let [db (await (get-db))]
    (await
     (.update db
              books-table
              (book-type/to-db-map book)
              .where "id = ?"
              .whereArgs [(:id book)]))))

(defn set-book-has-cover
  "Set to true the has_cover field"
  [book-id]
  (let [db (await (get-db))]
    (.update db
             books-table
             {"has_cover" true}
             .where "id = ?"
             .whereArgs [book-id])))

(defn delete-book
  "Delete a book from the database by id"
  [id]
  (let [db (await (get-db))]
    (await
     (.delete db
              books-table
              .where "id = ?"
              .whereArgs [id]))))

;; ************************************************
;; * Notes queries                                *
;; ************************************************
(defn update-book-note
  "Update a book in the database"
  [note]
  (let [db (await (get-db))]
    (await
     (.update db
              notes-table
              (note-type/to-db-map note)
              .where "id = ?"
              .whereArgs [(:id note)]))))

(defn get-book-notes
  "Get the notes of a book"
  [book-id]
  (let [db (await (get-db))]
    (->>
     (await
      (.query db
              notes-table
              .columns ["id" "book_id" "contents" "created_at"]
              .where "book_id = ?"
              .whereArgs [book-id]
              .orderBy "created_at ASC"))
     (map note-type/from-db-entry))))

(defn delete-note
  "Delete a book from the database by id"
  [note-id]
  (let [db (await (get-db))]
    (await
     (.delete db
              notes-table
              .where "id = ?"
              .whereArgs [note-id]))))

;; ************************************************
;; * Activities queries                           *
;; ************************************************
(defn get-book-activities
  "Get the activities of a book"
  [book-id]
  (let [db (await (get-db))]
    (->>
     (await
      (.query db
              activities-table
              .columns ["id" "book_id" "reading_time" "progress" "date" "created_at"]
              .where "book_id = ?"
              .whereArgs [book-id]
              .orderBy "date DESC"))
     (map activity-type/from-db-entry))))

(defn get-recent-activity
  "Query the last n activity items, each paired with its book"
  [n]
  (let [db (await (get-db))]
    (->>
     (await
      (.rawQuery db
                 (str "SELECT a.id AS activity_id, a.book_id, a.reading_time, "
                      "a.progress, a.date, "
                      "b.id, b.title, b.author, b.pages, b.status, b.format, "
                      "b.current_progress, b.favorite, b.created_at "
                      "FROM activities a "
                      "JOIN books b ON a.book_id = b.id "
                      "ORDER BY a.date DESC "
                      "LIMIT ?")
                 [n]))
     (map (fn [row]
            {:activity (activity-type/from-db-join-entry row)
             :book (book-type/from-db-entry row)})))))

(defn insert-book-activity
  "Insert a new activity on a book and update its progress"
  [activity]
  (let [db (await (get-db))]
    (.transaction db
                  (fn [^sqlite/Transaction transaction]
                    (await
                     (.insert transaction
                              activities-table
                              (activity-type/to-db-map activity)))
                    (await
                     (.update transaction
                              books-table
                              {"current_progress" (:progress activity)
                               "status" (if (= 1.0 (:progress activity))
                                          "done"
                                          "reading")}
                              .where "id = ?"
                              .whereArgs [(:book-id activity)]))))))

(defn get-activities-by-month
  "Query the activities done in a given month"
  [month year]
  (let [db (await (get-db))
        start-date (str year "-" (.padLeft (.toString month) 2 "0") "-01")
        end-date (str year "-" (.padLeft (.toString (inc month)) 2 "0") "-01")]
    (->>
     (await
      (.rawQuery db
                 (str "SELECT a.id AS activity_id, a.book_id, a.reading_time, "
                      "a.progress, a.date, "
                      "b.id, b.title, b.author, b.pages, b.status, b.format, "
                      "b.current_progress, b.favorite, b.created_at "
                      "FROM activities a "
                      "JOIN books b ON a.book_id = b.id "
                      "WHERE a.date >= ? AND a.date < ? "
                      "ORDER BY a.date DESC")
                 [start-date end-date]))
     (map (fn [row]
            {:activity (activity-type/from-db-join-entry row)
             :book (book-type/from-db-entry row)})))))

(defn get-first-activity-date
  "Query the date of the first activity"
  []
  (let [db (await (get-db))
        row (first
             (await
              (.query db
                      activities-table
                      .columns ["date"]
                      .orderBy "created_at ASC"
                      .limit 1)))]
    (if row
      (-> (get row "date")
          dart:core/DateTime.parse
          (.toLocal))
      (dart:core/DateTime.now))))