(ns paginae.book-search.query
  {:no-dynamic true}
  (:require ["dart:convert" :as convert]
            ["package:http/http.dart" :as http]
            [clojure.string :as str]
            [paginae.types.book-search-result :as book-search-result]
            [paginae.types.query-result :as query-result]))

(defn keep-book?
  "Whether an Open Library doc should be kept as a search result.
   Requires a :key and a non-blank :title."
  [doc]
  (let [title (get doc "title")]
    (and
     (contains? doc "key")
     (some? title)
     (not (str/blank? title)))))

(defn query-books
  "Query the Open Library to search for books"
  [query ;; Query to search
   offset ;; Offset of data to search
   unknown-str ;; String to use as placeholder when no data is provided
   no-response-str ;; String to return when no response
   ]

  (let [uri (Uri/https
             "openlibrary.org"
             "/search.json"
             {"q" (str "title: \"" query "\" OR author_name: \"" query "\" OR isbn: \"" query "\"")
              "fields" "author_name,title,cover_i,first_publish_year,key,cover_edition_key,number_of_pages_median"
              "limit" "20"
              "offset" (str offset)})]

    (letfn [(handle-error [error]
              (query-result/map->QueryResult
               {:total 0
                :offset 0
                :data []
                :error error}))

            (handle-response [^http/Response response]
              (if (= (.-statusCode response) 200)
                (let [json (convert/jsonDecode (.-body response))]
                  (query-result/map->QueryResult
                   {:total (get json "num_found")
                    :offset (get json "offset")
                    :data (map #(book-search-result/book-from-query-result % unknown-str)
                               (filter keep-book?
                                       (get json "docs" [])))}))
                (handle-error no-response-str)))]

      (-> (http/get uri)
          (.timeout (Duration .seconds 10))
          (.then handle-response)
          (.catchError (fn [_error]
                         (handle-error no-response-str)))))))