(ns paginae.home.home
  (:require ["../l10n/app_localizations.dart" :as app-l10n]
            ["package:carousel_slider/carousel_slider.dart" :as carousel]
            ["package:flutter/material.dart" :as material]
            [cljd.flutter :as flutter]
            [paginae.book-details.book-details :as book-details]
            [paginae.database :as db]
            [paginae.home.badges :as badges]
            [paginae.image.widget :as image]
            [paginae.theme :as theme]))

(defn- reading-book-card
  "Card to display currently reading book"
  [book
   update-books]

  (flutter/widget
   :get {{{:flds [titleLarge bodyMedium]} .-textTheme} material/Theme}
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)]
   :get [material/Navigator]

   (material/InkWell
    .onTap
    (fn []
      (let [_ (await (.push
                      navigator
                      (#/(material/MaterialPageRoute Object)
                       .builder
                       (flutter/build (book-details/book-details book)))))]
        (update-books)))

    .child
    (material/Card
     .child
     (material/Container

      .padding
      (material/EdgeInsets.all 10)

      .child
      (material/Column
       .crossAxisAlignment material/CrossAxisAlignment.center

       .mainAxisAlignment material/MainAxisAlignment.spaceBetween

       .children
       [(image/cover-image
         {:book book
          :placeholder-text (.-noCover locales)
          :bordered? false
          :clickable? false
          :on-click nil
          :width 175})

        (material/Column

         .children [(material/Text
                     (:title book)

                     .style
                     (.copyWith titleLarge
                                .fontWeight material/FontWeight.bold)

                     .overflow material/TextOverflow.ellipsis)

                    (material/Text
                     (if (nil? (:author book))
                       ""
                       (:author book))

                     .style bodyMedium

                     .overflow material/TextOverflow.ellipsis)])

        (let [progress (:current-progress book)
              pages (:pages book)]
          (material/Column
           .spacing 10

           .children [(material/Row

                       .mainAxisAlignment material/MainAxisAlignment.spaceBetween

                       .children
                       [(material/Text (.toUpperCase (.percentComplete locales (.round (* 100 progress)))))
                         (material/Text (if (nil? pages)
                                          ""
                                          (.toUpperCase (.pageCount locales (.round (* pages progress))))))])

                      (material/LinearProgressIndicator
                       .value progress)]))]))))))

(defn- books-reading
  "Widget to display currently reading books"
  [{:keys [books
           go-to-add
           on-pop]}]

  (flutter/widget
   :get {{{:flds [bodyMedium headlineSmall titleLarge titleMedium]} .-textTheme
          {:flds [primary onPrimary]} .-colorScheme} material/Theme}
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)]

   (material/SliverToBoxAdapter)

   .child
   (material/Center)

   .child
   (if (empty? books)
     ;; If no books, action to add one
     (material/Column

      .spacing 10

      .children
      [(material/Text
        (.-noBooks locales)

        .style (.copyWith titleLarge
                          .fontFamily "Manrope"))

       (material/FilledButton

        .onPressed go-to-add

        .child
        (material/Text
         (.toUpperCase (.-addNewBook locales))

         .style (.copyWith titleMedium
                           .color onPrimary
                           .fontFamily "Manrope"
                           .fontWeight material/FontWeight.bold)))])

     ;; List the reading books 
     (material/Column

      .spacing 10

      .children
      [(material/Row
        .mainAxisAlignment material/MainAxisAlignment.spaceBetween

        .children
        [;; Section title
         (material/Text
          (.-currentlyReading locales)
          .softWrap true
          .maxLines 2
          .style headlineSmall)

         ;; Book count 
         (material/Text
          (.toUpperCase ^String ((.-booksInProgress locales) (count books)))
          .softWrap true
          .maxLines 2
          .style (.copyWith bodyMedium
                            .fontWeight material/FontWeight.bold
                            .color primary))])

       ;; Book carousel
       (carousel/CarouselSlider.builder
        .itemCount
        (count books)

        .options
        (carousel/CarouselOptions
         .height 400

         .initialPage 0

         .enableInfiniteScroll false)

        .itemBuilder
        (fn [_context idx _pageViewIdx]
          (let [book (nth books idx)]
            (material/Padding
             .padding (material/EdgeInsets.symmetric .horizontal 4)
             .child (reading-book-card book on-pop)))))]))))

(defn- shelf-card
  "Card that represents a 'bookshelf' (group of books)"
  [{:keys [title subtitle bg-color number badge on-tap]}]
  (flutter/widget
   :get {{{:flds [headlineLarge titleLarge labelMedium]} .-textTheme
          {:flds [onSurfaceVariant]} .-colorScheme} material/Theme}

   (material/InkWell
    .onTap on-tap

    .child
    (material/Card

     .child
     (material/Padding

      .padding
      (material/EdgeInsets.symmetric .vertical 20 .horizontal 20)

      .child
      (material/Column

       .crossAxisAlignment material/CrossAxisAlignment.start

       .children
       [;; Icon and count
        (material/Row

         .mainAxisAlignment
         material/MainAxisAlignment.spaceBetween

         .children
         [;; Icon
          badge

          ;; Count
          (material/Text
           (str number)

           .style
           (.copyWith headlineLarge
                      .fontWeight material/FontWeight.w700
                      .color bg-color))])

        (material/SizedBox
         .height 20)

        ;; Title
        (material/Text
         title

         .style titleLarge)

        ;; Subtitle
        (material/Text
         (.toUpperCase ^String subtitle)

         .style (.copyWith labelMedium
                           .color (.withOpacity onSurfaceVariant 0.75)))]))))))

(defn- shelves
  "Widget that contains cards with book groups"
  [{:keys [counts
           go-to-to-read-shelf
           go-to-reading-shelf
           go-to-favorite-shelf
           go-to-done-shelf]}]
  (flutter/widget
   :get {{{:flds [headlineSmall]} .-textTheme} material/Theme}
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)
         portrait? (= material/Orientation.portrait (.-orientation (material/MediaQuery.of context)))]

   (material/SliverMainAxisGroup

    .slivers
    [(material/SliverToBoxAdapter

      .child
      (material/Text
       (.-myShelves locales)
       .softWrap true
       .maxLines 2
       .style headlineSmall))

     (material/SliverGrid.count
      .crossAxisCount (if portrait? 2 4)

      .children
      [(shelf-card
        {:title (.-shelfReadTitle locales)
         :subtitle (.-shelfReadSubtitle locales)
         :bg-color (:70 theme/primary)
         :number (:done counts)
         :badge (badges/read-badge)
         :on-tap go-to-done-shelf})

       (shelf-card
        {:title (.-shelfToReadTitle locales)
         :subtitle (.-shelfToReadSubtitle locales)
         :bg-color (:70 theme/secondary)
         :number (:to-read counts)
         :badge (badges/to-read-badge)
         :on-tap go-to-to-read-shelf})

       (shelf-card
        {:title (.-shelfFavoritesTitle locales)
         :subtitle (.-shelfFavoritesSubtitle locales)
         :bg-color (:70 theme/tertiary)
         :number (:favorite counts)
         :badge (badges/favorite-badge)
         :on-tap go-to-favorite-shelf})

       (shelf-card
        {:title (.-shelfReadingTitle locales)
         :subtitle (.-shelfReadingSubtitle locales)
         :bg-color (:70 theme/neutral)
         :number (:reading counts)
         :badge (badges/reading-badge)
         :on-tap go-to-reading-shelf})])])))

(defn- activity-card
  "Card for displaying a reading activity"
  [{:keys [activity book]}]
  (flutter/widget
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)]

   (material/Card)

   .child
   (material/Row)

   .children
   [(image/cover-image
     {:book book
      :placeholder-text (.-noCover locales)
      :bordered? false
      :clickable? false
      :on-click nil
      :width 100})

    (material/Column

     .children
     [(material/Text
       (:title book))

      (material/Text
       (.reachedPercent locales (.round (* 100 (:progress activity)))))])]))

(defn- recent-activity
  "Widget to display the most recent reading activity"
  [{:keys [activities
           go-to-journal]}]
  (flutter/widget
   :get {{{:flds [headlineSmall labelLarge]} .-textTheme
          {:flds [secondary]} .-colorScheme} material/Theme}
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)]

   (if (empty? activities)
     (material/SliverToBoxAdapter

      .child
      (material/Container))

     (material/SliverMainAxisGroup

      .slivers
      [(material/SliverToBoxAdapter

        .child
        (material/Row

         .mainAxisAlignment material/MainAxisAlignment.spaceBetween

         .children
         [(material/Text
           (.-recentActivity locales)
           .softWrap true
           .maxLines 2
           .style headlineSmall)

          (material/TextButton

           .child
           (material/Text
            (.toUpperCase (.-viewJournal locales))

            .style (.copyWith labelLarge
                              .color secondary))

           .onPressed go-to-journal)]))

       (material/SliverList
        .delegate
        (material/SliverChildBuilderDelegate
         (fn [_context idx]
           (when (< idx (count activities))
             (let [entry (nth activities idx)]
               (activity-card entry))))))]))))

(defn home-widget
  "Widget that shows the home screen"
  [{:keys [go-to-add
           go-to-journal
           go-to-to-read-shelf
           go-to-reading-shelf
           go-to-favorite-shelf
           go-to-done-shelf]}]
  (flutter/widget
   :get {{{:flds [headlineMedium]} .-textTheme} material/Theme}
   :context context
   :let [locales (app-l10n/AppLocalizations.of context)]
   :watch [revision (atom 0) :as data-revision
           books (db/get-books-by-status :reading) :default [] :refresh-on revision
           counts (db/get-book-counts) :default {:to-read 0
                                                 :favorite 0
                                                 :done 0
                                                 :read 0} :refresh-on revision
            last-activities (db/get-recent-activity 5) :default [] :refresh-on revision]

   (material/CustomScrollView
    .slivers
    [;; App bar
     (material/SliverAppBar
      .pinned false

      .floating true

      .flexibleSpace
      (material/Center
       .child
       (material/Text
        (.-homeTitle locales)

        .style
        (.copyWith headlineMedium
                   .fontWeight material/FontWeight.bold))))

     (books-reading
      {:go-to-add go-to-add
       :books books
       :on-pop #(swap! data-revision inc)})

     (material/SliverToBoxAdapter
      .child
      (material/SizedBox
       .height 30))

     (shelves
      {:counts counts
       :go-to-to-read-shelf
       (fn []
         (await (go-to-to-read-shelf))
         (swap! data-revision inc))
       :go-to-reading-shelf
       (fn []
         (go-to-reading-shelf)
         (swap! data-revision inc))
       :go-to-favorite-shelf
       (fn []
         (go-to-favorite-shelf)
         (swap! data-revision inc))
       :go-to-done-shelf
       (fn []
         (go-to-done-shelf)
         (swap! data-revision inc))})

     (material/SliverToBoxAdapter
      .child
      (material/SizedBox
       .height 30))

     (recent-activity
      {:activities last-activities
       :go-to-journal go-to-journal})])))